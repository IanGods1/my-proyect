rules_version = '2';

// Reglas de seguridad de Guastaccesorio.
// Copia TODO este archivo en Firebase: Firestore Database > Reglas > Publicar.
//
// - Solo el ADMINISTRADOR puede escribir datos.
// - El TRABAJADOR solo puede leer, y solo mientras su sesión tenga la contraseña de trabajador
//   vigente. Cuando el administrador la cambia, todas las sesiones de trabajador dejan de servir.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuenta del administrador (la crea la app; el correo es interno y nunca se escribe a mano).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'admin@guastaccesorio.app';
    }

    // Clave vigente de la contraseña de trabajador (solo la conoce el servidor).
    function workerToken() {
      return get(/databases/$(database)/documents/private/worker).data.token;
    }

    function isWorker() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.token == workerToken();
    }

    // Configuración pública: indica si ya se crearon las contraseñas y la versión de la
    // contraseña de trabajador. No contiene contraseñas.
    match /public/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clave de la contraseña de trabajador: nadie la puede leer salvo el administrador.
    match /private/{doc} {
      allow read, write: if isAdmin();
    }

    // Sesión de cada teléfono de trabajador: solo se puede crear con la contraseña correcta.
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token == workerToken();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Datos de compatibilidad.
    match /models/{id} {
      allow read: if isAdmin() || isWorker();
      allow write: if isAdmin();
    }
    match /groups/{id} {
      allow read: if isAdmin() || isWorker();
      allow write: if isAdmin();
    }

    // Todo lo demás está prohibido.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
